{
  "name": "@openclaw/trading-plugin",
  "version": "2026.3.11",
  "description": "OpenClaw 的 trading-agent 正式运行时插件",
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "0.34.48"
  },
  "devDependencies": {
    "openclaw": "2026.3.11"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/trading-plugin",
      "localPath": "extensions/trading-plugin",
      "defaultChoice": "local"
    }
  }
}
